{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": "WordPress/WordPress#7.1.3",
  "phpVersion": "8.2",
  "themes": ["https://downloads.wordpress.org/theme/astra.4.14.0.zip"],
  "plugins": [
    "./plugin/wg-live",
    "https://downloads.wordpress.org/plugin/elementor.4.3.4.zip",
    "https://downloads.wordpress.org/plugin/woocommerce.11.2.1.zip"
  ],
  "port": 8888,
  "testsPort": 8889,
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_DISPLAY": false,
    "WP_ENVIRONMENT_TYPE": "local"
  },
  "mappings": {
    "wp-content/wg-live-scripts": "./scripts"
  },
  "env": {
    "tests": {
      "config": {
        "WP_ENVIRONMENT_TYPE": "production"
      }
    }
  },
  "lifecycleScripts": {
    "afterStart": "node scripts/wp-env-setup.mjs"
  }
}
